# Common environment configuration for Swarm deployment.
MM_SQLSETTINGS_DRIVERNAME=postgres
MM_SQLSETTINGS_DATASOURCE=postgres://mmuser:mostest@db:5432/mattermost?sslmode=disable&connect_timeout=10
MM_CLUSTERSETTINGS_ENABLE=true
MM_CLUSTERSETTINGS_CLUSTERNAME=mm-ha
MM_CLUSTERSETTINGS_BINDADDRESS=0.0.0.0
MM_CLUSTERSETTINGS_GOSSIPPORT=7946
MM_CLUSTERSETTINGS_LEADERELECTIONMODE=db
MM_SERVICESETTINGS_LISTENADDRESS=:8065
MM_LOGSETTINGS_ENABLECONSOLE=true
MM_LOGSETTINGS_CONSOLELEVEL=DEBUG
MM_CONFIG=postgres://mmuser:mostest@db:5432/mattermost?sslmode=disable&connect_timeout=10


